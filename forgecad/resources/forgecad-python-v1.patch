+        FC_PY_SDK_RELEASE_V1,FC_PY_PYTHON_HEX_V1,64,sizeof(wchar_t)*8,0,
+        FC_PY_CONTRACT_SHA256_BYTES,{forgecad_contract_json,sizeof(forgecad_contract_json)-1},
